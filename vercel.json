{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "site",
  "framework": null,
  "installCommand": "echo 'skipping install'",
  "buildCommand": "node scripts/copy-docs.mjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/install", "destination": "/install.md" },
    { "source": "/docs/:name", "destination": "/docs/:name.md" },
    { "source": "/docs/:subdir/:name", "destination": "/docs/:subdir/:name.md" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
