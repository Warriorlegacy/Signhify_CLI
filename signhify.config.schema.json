{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://signhify.dev/schema/signhify.config.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/providerConfig"
        },
        "autocomplete": {
          "$ref": "#/$defs/providerConfig"
        },
        "fallbackChain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fallbackEndpointConfig"
          },
          "description": "Prioritized fallback provider chain for resilient zero-cost model routing."
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/customMode"
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenBudget": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000,
          "default": 4000,
          "description": "Max tokens of memory injected per turn."
        },
        "checkpointThresholdPct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "Context-window usage % that triggers a checkpoint."
        },
        "contextLimit": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2000000,
          "default": 128000,
          "description": "Sliding-window active context budget limit in tokens."
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shellAllowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Shell commands allowed in --auto mode. Empty = all allowed."
        },
        "shellDenylist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Shell commands always denied, even in --auto mode."
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mcpServer"
      },
      "description": "MCP servers to connect to."
    }
  },
  "$defs": {
    "providerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "type": "string",
          "enum": ["anthropic", "google", "openai", "openai-compatible", "groq", "xai", "mistral", "cerebras", "togetherai", "perplexity", "mock"],
          "description": "Model vendor identifier."
        },
        "model": {
          "type": "string",
          "description": "Model identifier (e.g. gpt-4o-mini, claude-3-5-sonnet, gemini-2.0-flash)."
        },
        "apiKeyRef": {
          "type": "string",
          "description": "API key reference. Format: 'env:VAR_NAME' or literal key."
        },
        "baseUrl": {
          "type": "string",
          "description": "Base URL for openai-compatible providers."
        }
      },
      "required": ["vendor", "model"]
    },
    "fallbackEndpointConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Endpoint identifier name (e.g. 9router-local, google-gemini-free)."
        },
        "vendor": {
          "type": "string",
          "description": "Model vendor identifier."
        },
        "model": {
          "type": "string",
          "description": "Model identifier."
        },
        "apiKeyRef": {
          "type": "string",
          "description": "API key reference or literal key."
        },
        "baseUrl": {
          "type": "string",
          "description": "Base URL for local or proxy endpoints."
        },
        "isLocal": {
          "type": "boolean",
          "description": "Whether this endpoint is on localhost."
        }
      },
      "required": ["name", "vendor", "model"]
    },
    "customMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Mode identifier used to switch into this mode."
        },
        "prompt": {
          "type": "string",
          "description": "System prompt for this mode."
        },
        "allowedTools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools this mode is allowed to use."
        }
      },
      "required": ["name", "prompt", "allowedTools"]
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Server display name."
        },
        "command": {
          "type": "string",
          "description": "Command to spawn the server process (stdio transport)."
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments passed to the command."
        },
        "transport": {
          "type": "string",
          "enum": ["stdio", "sse", "http"],
          "default": "stdio",
          "description": "MCP transport protocol."
        },
        "url": {
          "type": "string",
          "description": "URL for remote SSE or HTTP MCP server."
        }
      },
      "required": ["name"]
    }
  }
}
