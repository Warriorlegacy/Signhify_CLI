{
  "name": "signhify",
  "displayName": "Signhify — AI Engineering Agent",
  "description": "Your AI engineering partner — in the terminal and in the IDE",
  "version": "0.3.2",
  "publisher": "signhify",
  "repository": {
    "type": "git",
    "url": "https://github.com/Warriorlegacy/Signhify_CLI.git"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:signhify.newTask"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "signhify.newTask",
        "title": "Signhify: New Task"
      },
      {
        "command": "signhify.setApiKey",
        "title": "Signhify: Set API Key"
      },
      {
        "command": "signhify.clearApiKey",
        "title": "Signhify: Clear API Key"
      },
      {
        "command": "signhify.openSettings",
        "title": "Signhify: Open Settings"
      },
      {
        "command": "signhify.setAutocompleteApiKey",
        "title": "Signhify: Set Autocomplete API Key"
      },
      {
        "command": "signhify.switchMode",
        "title": "Signhify: Switch Mode"
      },
      {
        "command": "signhify.openMemory",
        "title": "Signhify: Open Memory"
      },
      {
        "command": "signhify.triggerInlineCompletion",
        "title": "Signhify: Trigger Inline Completion"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "signhify",
          "title": "Signhify",
          "icon": "resources/signhify-icon.png"
        }
      ]
    },
    "views": {
      "signhify": [
        {
          "type": "webview",
          "id": "signhify.chat",
          "name": "Signhify Chat"
        }
      ]
    },
    "configuration": {
      "title": "Signhify",
      "properties": {
        "signhify.provider.vendor": {
          "type": "string",
          "enum": [
            "anthropic",
            "google",
            "openai",
            "openai-compatible"
          ],
          "default": "openai",
          "description": "Model provider"
        },
        "signhify.provider.model": {
          "type": "string",
          "default": "gpt-4",
          "description": "Model name"
        },
        "signhify.provider.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for OpenAI-compatible providers"
        },
        "signhify.provider.autocomplete.vendor": {
          "type": "string",
          "enum": [
            "anthropic",
            "google",
            "openai",
            "openai-compatible"
          ],
          "default": "openai-compatible",
          "description": "Model provider for inline autocomplete"
        },
        "signhify.provider.autocomplete.model": {
          "type": "string",
          "default": "gpt-4",
          "description": "Model name for inline autocomplete"
        },
        "signhify.provider.autocomplete.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for inline autocomplete provider"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:playwright --external:playwright-core --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:playwright --external:playwright-core --format=cjs --platform=node --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "clean": "node -e \"const {rmSync,existsSync}=require('fs');['dist','*.tsbuildinfo'].forEach(p=>{if(existsSync(p))rmSync(p,{recursive:true,force:true})})\""
  },
  "dependencies": {
    "@signhify/core": "^0.3.2",
    "@signhify/providers": "^0.3.2",
    "@signhify/tools": "^0.3.2",
    "@signhify/memory": "^0.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
